# Configuración de Gustavo4Bot
# Variables de entorno para el bot de Telegram

# ============================================================================
# CONFIGURACIÓN PRINCIPAL DEL BOT
# ============================================================================

# Token del bot de Telegram obtenido de @BotFather
TELEGRAM_TOKEN=tu_token_del_bot_aqui

# ID del propietario del bot (tu usuario de Telegram)
OWNER_ID=tu_user_id_aqui

# ID del chat fuente del que recuperar multimedia
CHAT_SOURCE_ID=id_del_chat_fuente

# ID del canal donde publicar multimedia con spoiler
PUBLISH_CHANNEL_ID=id_del_canal_publicacion

# ID del canal para almacenar archivos
STORAGE_CHANNEL_ID=id_del_canal_almacenamiento

# ============================================================================
# CONFIGURACIÓN ADICIONAL
# ============================================================================

# Nivel de logs (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Zona horaria para los logs
TZ=Europe/Madrid

# ============================================================================
# INSTRUCCIONES PARA OBTENER LOS IDs NECESARIOS
# ============================================================================
#
# 🔍 Para obtener tu ID de usuario (OWNER_ID):
#   1. Envía /start a @userinfobot en Telegram
#   2. El bot te responderá con tu ID de usuario
#   3. Ejemplo: OWNER_ID=123456789
#
# 🔍 Para obtener IDs de canales/grupos:
#   1. Agrega @userinfobot al canal o grupo
#   2. El bot mostrará el ID del chat
#   3. Los IDs de canales/grupos empiezan con -100
#   4. Ejemplo: CHAT_SOURCE_ID=-1001234567890
#
# 🔍 Para crear un bot y obtener el token:
#   1. Habla con @BotFather en Telegram
#   2. Usa el comando /newbot
#   3. Sigue las instrucciones
#   4. Copia el token proporcionado
#   5. Ejemplo: TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
#
# ⚠️  IMPORTANTE:
#   - No compartas nunca tu token del bot
#   - El bot debe ser administrador en todos los canales/grupos
#   - Asegúrate de que los IDs son correctos antes de ejecutar
#
# ============================================================================
# EJEMPLO DE CONFIGURACIÓN COMPLETA
# ============================================================================
#
# TELEGRAM_TOKEN=7850932225:AAF5ACUWuvwI0Av8tt9Q4_yRXBWPFlxbxa0
# OWNER_ID=14824267
# CHAT_SOURCE_ID=-4862761333
# PUBLISH_CHANNEL_ID=-1002795030702
# STORAGE_CHANNEL_ID=-1002834323493
# LOG_LEVEL=INFO
# TZ=Europe/Madrid